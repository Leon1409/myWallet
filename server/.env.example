# Skopiuj ten plik do .env i uzupełnij wartości

# Połączenie z PostgreSQL (dostosuj użytkownika/hasło/bazę)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mywallet

# Port API
PORT=4000

# Sekret do podpisywania tokenów JWT — ustaw długi, losowy ciąg!
JWT_SECRET=zmien-mnie-na-dlugi-losowy-sekret

# Origin klienta (Vite dev server), rozdzielone przecinkami jeśli kilka
CLIENT_ORIGIN=http://localhost:5173

# Maks. liczba połączeń puli pg (domyślnie 10; zmniejsz przy współdzielonej bazie, np. home.pl)
PG_POOL_MAX=10

# Odczyt paragonów przez AI — klucz OpenCode Go (opencode.ai/console → Go)
# albo Z.ai Coding Plan. Model musi mieć vision (np. glm-5.3-flash; glm-5.2
# jest tekstowy). Go rozlicza się z limitem subskrypcji, nie z salda.
AI_API_KEY=
# Opcjonalnie (mają sensowne domyślne wartości):
# AI_BASE_URL=https://opencode.ai/inference/go
# AI_MODEL=glm-5.3-flash
